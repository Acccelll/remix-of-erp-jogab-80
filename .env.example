# Template versionado de variáveis de ambiente (OPS-005).
# Copie para `.env.local` (ignorado pelo Git) preenchendo os valores reais.
# `.env` é gerenciado automaticamente pela plataforma Lovable Cloud — NÃO editar.
#
# Convenções:
# - Toda variável exposta ao cliente Vite DEVE usar o prefixo VITE_.
# - Valores sensíveis (service role, secrets) NUNCA entram aqui.
#   Use o cofre da plataforma (menu Backend › Secrets).

# --- Backend (Lovable Cloud / Supabase) ------------------------------------
# Fornecidas automaticamente pela plataforma; documentadas aqui para clareza.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- API legada (bootstrap MySQL) ------------------------------------------
# URL do backend clássico usado enquanto a migração para Cloud não finaliza.
VITE_API_URL="http://localhost:8787"

# --- Observabilidade (opcional em dev, obrigatório em prod) ----------------
# Sentry: DSN por ambiente. Vazio = error tracking desligado.
VITE_SENTRY_DSN=""
# Release exibido no Sentry (ex.: SHA curto do commit ou tag de deploy).
VITE_APP_RELEASE="dev"
