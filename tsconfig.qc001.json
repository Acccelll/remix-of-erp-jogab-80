{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true
  },
  "include": [
    "src/vite-env.d.ts",
    "src/integrations/supabase/client-augment.d.ts",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/services/**/*.ts",
    "src/services/**/*.tsx"
  ]
}
